{
  "name": "shengyue-voice-website",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
