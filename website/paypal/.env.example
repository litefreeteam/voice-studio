PAYPAL_PORT=3087
PAYPAL_DATA_DIR=/var/lib/shengyue-paypal
PAYPAL_ENV=live
PAYPAL_SITE_ORIGIN=https://voice.freeteam.top
# Empty: persist notifications as unverified (HTTP 202). Set the actual ID to enable verification.
# This is the Webhook ID from PayPal App settings, not a client ID or client secret.
PAYPAL_WEBHOOK_ID=
# PayPal receiving account; configure at least one for automatic fulfillment.
PAYPAL_RECEIVER_EMAIL=
PAYPAL_MERCHANT_ID=
LICENSE_PRIVATE_KEY_PATH=/etc/shengyue-paypal/signing-key.pem
# SMTP is configured separately in /etc/shengyue-paypal-mail.env (root-only).
