    },
    "design:warm-female": {
      "file": "warm-female.mp3",
      "text": "今天的事情终于忙完了。要不要一起出去走走？路口新开了一家小店，我们可以顺便看看。",
      "duration": 7.992,
      "language": "Chinese",
