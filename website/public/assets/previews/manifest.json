      "sha256": "0368e830c2800b1dfdc7e0ee5f6153e3c2bbb66e0414e53a1b3daf047f8cd0a0"
    },
    "design:girl-clear": {
      "file": "girl-clear.mp3",
      "text": "今天老师夸我的画好看，我开心极了！放学以后，我还想画一只戴帽子的小猫。",
      "duration": 7.728,
