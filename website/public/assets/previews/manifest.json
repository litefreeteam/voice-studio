      "sha256": "fd3768a4fd7906d653f4675564e84dd8ddb423e4d2c86b0447e7426cd921d13b"
    },
    "design:storybook-female": {
      "file": "storybook-female.mp3",
      "text": "小狐狸捡到了一片会发光的叶子。它小心地捧着，想把这份惊喜带给森林里的朋友。",
      "duration": 7.84,
      "language": "Chinese",
      "fingerprint": "edc495ba3c48ef058197f6c441e1a7762ff14a7ce77fb08e3b2c36db3ad87204",
      "sha256": "fb1ad88c0e2c434a0b447814a78827b2e74e2e8d330d3dbd72ae1735026799cb"
    },
    "design:clear-male": {
      "file": "clear-male.mp3",
      "text": "冰箱里的食物，为什么要留一点空隙？因为冷空气需要流动，塞得太满，反而会让里面的食物降温更慢。",
      "duration": 8.98,
      "language": "Chinese",
      "fingerprint": "77182d5c8201921ad76b9e9e575128e47cd49e2a446d41879a6dac3db92fec1a",
      "sha256": "c1d8b1576a47530fa0d2a3a9f11a78b6c719f2928b69826268b865a38ca6d2ca"
    },
    "design:warm-male": {
      "file": "warm-male.mp3",
      "text": "末班车驶过桥头，车窗里映着万家灯火。他把给女儿买的那本书抱在怀里，想到家，嘴角便慢慢扬了起来。",
      "duration": 10.7,
      "language": "Chinese",
