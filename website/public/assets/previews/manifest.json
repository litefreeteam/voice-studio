      "sha256": "273c9711f681695fb1f15ba7e9dba730d0ecdde24d9689e3b29f34680e91c106"
    },
    "design:boy-clear": {
      "file": "boy-clear.mp3",
      "text": "你看，我把小飞机拼好啦！等会儿我们去院子里，看看它能不能飞得更远。",
      "duration": 7.488,
      "language": "Chinese",
