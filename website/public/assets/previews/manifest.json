      "sha256": "602f4a2dd6fc70bb75f4e18897f9d7b1652dd66343a31d6c39c4131a1b3886c5"
    },
    "design:elegant-female": {
      "file": "elegant-female.mp3",
      "text": "早晨，磨好的咖啡粉遇上热水，香气慢慢舒展开来。给忙碌的一天留几分钟，从一杯认真冲泡的咖啡开始。",
      "duration": 10.88,
      "language": "Chinese",
