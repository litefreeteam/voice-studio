      "sha256": "0d07290bbca836f06ee741227bb0bca62f8ccd9e839083666dda2768e285077e"
    },
    "design:steady-male": {
      "file": "steady-male.mp3",
      "text": "推开窗，新风穿过整间屋子。从第一道密封，到每一次安静开合，让舒适落在生活的每一处细节里。",
      "duration": 9.2,
      "language": "Chinese",
