      "sha256": "a949958ad4c5a8f530c10fbe8c2b33dff4aa5b960653ac3b9497bd04990872c6"
    },
    "design:documentary-male": {
      "file": "documentary-male.mp3",
      "text": "清晨的第一缕光，落在古老的街道上。人们在日常的往来中，续写着这座城市的故事。",
      "duration": 9.27,
      "language": "Chinese",
      "fingerprint": "da55d51b4d5bf4201e2aee8b953764c994472e7bb98c72e514d25836fab89552",
      "sha256": "4f445f8a79833b4afc946d381c9c0cdde446bacf85713737ace3c30c00209128"
    },
    "design:podcast-female": {
      "file": "podcast-female.mp3",
      "text": "我发现，越是把日程排满，越容易觉得什么都没做好。后来我每天只留三件重要的事，反而能按时下班了。",
      "duration": 9.1,
      "language": "Chinese",
      "fingerprint": "18bbb5560445676e5c1a60e4a0d548f9ecfe5269ec6c9d6d1b959aef27cef3ce",
      "sha256": "f596957b6bc6214391ac27ae8d9985d3d23ff1fb3c9f5d01355ab9864f4d2ed4"
    },
    "design:podcast-male": {
      "file": "podcast-male.mp3",
      "text": "我也试过把所有事情都记下来，结果清单越写越长。后来每天先做最重要的一件，心里反而踏实了不少。",
      "duration": 10.88,
      "language": "Chinese",
      "fingerprint": "8785700f784cdc57a95354b8ddfce865c7f6c19314d8413ae91e869a3aa7bade",
      "sha256": "ea1bbdb23850c8885f7ae9298822b705e85a70e18f46fe9e50ca902e63a85922"
    },
    "design:commerce-female": {
      "file": "commerce-female.mp3",
      "text": "钥匙、耳机总在桌上找不到？把这个小收纳盒放在门边，回家顺手一放，第二天出门就不用翻包了。",
      "duration": 10.17,
      "language": "Chinese",
      "fingerprint": "843b3f9ff22feb038b2f560198781be7d952b56cb62ef588e1b1074409ab49ec",
      "sha256": "3ada8ba1e55d749b0a9e1ffa687a1d6a3e3bbacfd07d3a2cc91b7b8e33cbb76e"
    },
    "design:brand-male": {
      "file": "brand-male.mp3",
      "text": "一块木头，经过打磨，留下温润的纹理。从桌角的弧度，到手掌碰到的每一处表面，我们都认真做好。",
      "duration": 12.56,
      "language": "Chinese",
      "fingerprint": "be72da3c7c5708ebb91e0b157baf6e4a2c5c463bf600942cf61ff52494d08b5c",
      "sha256": "8d8c8d7f26c1b7ce83792f13fedf65898b1106be7e52805e91da60870b3fbef0"
    },
    "design:service-female": {
      "file": "service-female.mp3",
      "text": "您预约的图书已送达，请在三天内携带借阅证，到一楼服务台领取。图书馆今天开放至晚上九点。",
      "duration": 10.25,
      "language": "Chinese",
      "fingerprint": "9fa2be4d7c59e945b0c82427aa27829af48afdd1ec2270e716ec7eca24bc5522",
      "sha256": "16bcd08e7c8bfa74fd1e3ab28f618cc61d100c78aa88efdf520017827dee8ff4"
    },
    "design:meditation-female": {
      "file": "meditation-female.mp3",
      "text": "把注意力轻轻放回此刻。感受一次自然的呼吸，让肩膀慢慢放松下来。",
      "duration": 9.67,
      "language": "Chinese",
      "fingerprint": "915f8d89d36faac9fd9151ef54743c762b0c763a3e237c4ef039627ed9edf742",
      "sha256": "2e5a7fcfa958e61ef64e5a7589f6a0a4985d69a5c8d4e0147fc7944ff9eaaa9c"
    },
    "design:youth-female": {
      "file": "youth-female.mp3",
      "text": "走吧，今天的天气这么好。我们去看看新开的书店，也许会遇见喜欢的故事。",
      "duration": 6.64,
      "language": "Chinese",
